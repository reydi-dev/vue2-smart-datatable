{
  "version": "0.1.0",
  "private": true,
  "description": "A reusable, backend-neutral data table for Vue 2.7 and Vuetify 2.6.",
  "author": {
    "name": "Mohammad Reza Dehghani",
    "url": "https://github.com/reydi-dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reydi-dev/vue2-smart-datatable.git"
  },
  "homepage": "https://github.com/reydi-dev/vue2-smart-datatable#readme",
  "bugs": {
    "url": "https://github.com/reydi-dev/vue2-smart-datatable/issues"
  },
  "keywords": [
    "vue",
    "vue2",
    "vuetify",
    "data-table",
    "datatable"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/smart-data-table.cjs",
  "module": "./dist/smart-data-table.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/smart-data-table.js",
      "require": "./dist/smart-data-table.cjs"
    },
    "./styles.css": "./dist/style.css",
    "./adapters/csv": {
      "types": "./dist/types/adapters/exporters/csv.d.ts",
      "import": "./dist/smart-data-table.js",
      "require": "./dist/smart-data-table.cjs"
    },
    "./adapters/local-storage": {
      "types": "./dist/types/adapters/persistence/local-storage.d.ts",
      "import": "./dist/smart-data-table.js",
      "require": "./dist/smart-data-table.cjs"
    }
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "npm run typecheck && vite build && npm run build:types",
    "build:types": "vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src tests examples --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:dist": "vitest run tests/consumer"
  },
  "peerDependencies": {
    "vue": "^2.7.0",
    "vuetify": ">=2.6.0 <3"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue2": "^2.3.3",
    "@vue/test-utils": "^1.3.6",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "sass": "^1.90.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.8",
    "vue": "2.7.16",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^2.2.12",
    "vuetify": "2.6.15"
  }
}
